# ============================================================
# INTERTER — Variables d'environnement
# Copie ce fichier en `.env.local` puis remplis les valeurs.
# Ne commit JAMAIS `.env.local` (il est dans .gitignore).
# ============================================================

# --- Supabase (Dashboard > Settings > API) ---
# URL du projet, public (visible côté navigateur, protégée par la RLS)
NEXT_PUBLIC_SUPABASE_URL=https://TON-PROJET.supabase.co

# Clé anonyme, publique (les règles RLS protègent les données)
NEXT_PUBLIC_SUPABASE_ANON_KEY=ta-cle-anon-ici

# Clé service_role : SECRET ABSOLU, côté serveur uniquement (webhooks Stripe, admin)
SUPABASE_SERVICE_ROLE_KEY=ta-cle-service-role-ici

# --- Stripe (Dashboard > Developers > API keys) ---
STRIPE_SECRET_KEY=sk_test_...
# Secret du webhook (Dashboard > Developers > Webhooks > signature)
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Site ---
# URL publique de l'app : http://localhost:3000 en local, https://interter.fr en prod
NEXT_PUBLIC_SITE_URL=http://localhost:3000
